APP_NAME=MK Construction API
ENVIRONMENT=development
DEBUG=true

DATABASE_URL=mysql+aiomysql://root:root@127.0.0.1:3306/Mk

JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

REDIS_URL=redis://localhost:6379/0

MAX_GST_PERCENTAGE=28

# CMS Media Storage Settings
MEDIA_ROOT=media_storage
MEDIA_URL_PREFIX=/media
MEDIA_BASE_URL=
MEDIA_MAX_FILE_SIZE_BYTES=5242880
MEDIA_MAX_BATCH_SIZE=20

